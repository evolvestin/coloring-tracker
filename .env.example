# Copy this file to .env and replace the values before a public deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
VITE_DEV_MODE=false
WEB_PORT=8022
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_WEBAPP_URL=https://your-public-webapp-url
# Channel/group receiving new catalogue suggestions. A numeric id usually starts with -100.
TELEGRAM_SUGGESTIONS_CHAT_ID=

POSTGRES_DB=coloring_tracker
POSTGRES_USER=coloring_tracker
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Google Drive: create this one empty file manually, then share it (or its
# folder) with the service account as Editor. The service account must only
# update this pre-existing file; it cannot create a backup file itself.
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_FILENAME=coloring_tracker_backup.json

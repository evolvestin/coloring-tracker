# Copy this file to .env and replace the values before a public deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
VITE_DEV_MODE=false
WEB_PORT=8022
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_WEBAPP_URL=https://your-public-webapp-url
# Digital support inside Telegram uses Telegram Stars (currency XTR).
TELEGRAM_STARS_ENABLED=false
TELEGRAM_STARS_TEST_MODE=false
# Group of moderators receiving suggestions and replies. A numeric id usually starts with -100.
TELEGRAM_SUGGESTIONS_CHAT_ID=-1003812801448

POSTGRES_DB=coloring_tracker
POSTGRES_USER=coloring_tracker
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Telegram PostgreSQL backup. Keep disabled until the private channel exists.
TELEGRAM_BACKUP_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

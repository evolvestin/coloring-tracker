# Copy this file to .env and replace the values before a public deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
VITE_DEV_MODE=false
WEB_PORT=8022
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
WEBAPP_PUBLIC_URL=https://your-public-https-url
COMPOSE_PROFILES=tunnel

POSTGRES_DB=coloring_tracker
POSTGRES_USER=coloring_tracker
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

:8000 {
    # Vite is never published directly. Browser and Telegram reach it only
    # through the same HTTPS origin as the Django WebApp.
    @vite path /__vite__/* /hmr /hmr/*
    reverse_proxy @vite frontend:5173

    # User photos are served by the public WebApp origin in every mode.
    handle_path /media/* {
        root * /srv/data/media
        file_server
    }

    reverse_proxy web:8000
}
